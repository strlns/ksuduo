#!/usr/bin/env bash
# Optional local deployment for pushes of master to origin.
set -euo pipefail
[[ "${1:-}" = origin ]] || exit 0

while read -r local_ref local_oid remote_ref remote_oid; do
  [[ "$remote_ref" = refs/heads/master ]] || continue
  [[ "$local_oid" =~ ^0+$ ]] && continue
  project_dir="$(git rev-parse --show-toplevel)"
  # SSH must not consume Git's remaining ref-update input.
  KSUDUO_DEPLOY_COMMIT="$local_oid" "$project_dir/deploy-paperclip-factory.sh" </dev/null
done
