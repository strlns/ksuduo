{
  "author": "Moritz Rehbach",
  "description": "toy project",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "clsx": "^2.1.1",
    "lodash-es": "^4.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "license": "GPL-3.0-or-later",
  "name": "ksuduo",
  "private": true,
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "npm run typecheck && vite build && mkdir -p dist/docs && cp -R docs/ai dist/docs/",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "node --import tsx --import ./tests/legacy-globals.mjs tests/tests.ts",
    "test:legacy:verbose": "node --import tsx --import ./tests/legacy-globals.mjs tests/tests.ts --verbose",
    "serve-tests": "vite --config tests/vite.config.ts",
    "serve-tests-verbose": "vite --config tests/vite.config.ts --mode verbose"
  },
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  }
}
